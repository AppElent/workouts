{
  "name": "@foundry/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "devbuild:android": "expo run:android",
    "devbuild:android:clean": "expo prebuild --platform android --clean && expo run:android",
    "devbuild:android:eas": "eas build --platform android --profile development",
    "devbuild:ios": "expo run:ios",
    "devbuild:ios:eas": "eas build --platform ios --profile development",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "preview:ios:build": "eas build --platform ios --profile preview --clear-cache --auto-submit",
    "preview:ios:update": "node scripts/publish-update.mjs --platform ios --channel preview --environment preview",
    "update:publish": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^4.10.1",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "~58.0.16",
    "@foundry/core": "workspace:*",
    "@sentry/react-native": "~8.30.0",
    "@tanstack/react-form": "^1.33.5",
    "convex": "^1.46.0",
    "convex-helpers": "0.1.120",
    "expo": "~58.0.9",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.14",
    "expo-auth-session": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.11",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.13",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "^58.0.6",
    "expo-image": "~58.0.14",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.12",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.3",
    "expo-router": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.17",
    "expo-splash-screen": "~58.0.8",
    "expo-sqlite": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-updates": "~58.0.16",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.29.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0-rc.4",
    "@sentry/cli": "3.8.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-device-hub": "^0.13.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.9",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}

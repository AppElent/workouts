{
  "name": "@foundry/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "devbuild:android": "expo run:android",
    "devbuild:android:clean": "expo prebuild --platform android --clean && expo run:android",
    "devbuild:android:eas": "eas build --platform android --profile development",
    "devbuild:ios": "expo run:ios",
    "devbuild:ios:eas": "eas build --platform ios --profile development",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "preview:ios:build": "eas build --platform ios --profile preview --clear-cache --auto-submit",
    "preview:ios:update": "node scripts/publish-update.mjs --platform ios --channel preview --environment preview",
    "update:publish": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^4.10.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.22",
    "@foundry/core": "workspace:*",
    "@sentry/react-native": "~8.30.0",
    "@tanstack/react-form": "^1.33.5",
    "convex": "^1.46.0",
    "convex-helpers": "0.1.120",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.19",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "^57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@sentry/cli": "3.8.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "expo-device-hub": "^0.13.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}

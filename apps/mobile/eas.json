{
	"cli": {
		"version": ">= 16.0.1",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"autoIncrement": true,
			"channel": "development",
			"environment": "development",
			"android": {
				"buildType": "apk"
			}
		},
		"preview": {
			"autoIncrement": true,
			"channel": "preview",
			"environment": "preview"
		},
		"preview-internal": {
			"extends": "preview",
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"autoIncrement": true,
			"channel": "production",
			"environment": "production"
		}
	},
	"submit": {
		"preview": {
			"ios": {}
		},
		"production": {
			"ios": {}
		}
	}
}

{
	"expo": {
		"slug": "foundry",
		"version": "1.0.0",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/9cd74697-33c2-4706-a53e-89627a3b1994"
		},
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"CFBundleAllowMixedLocalizations": true,
				"ITSAppUsesNonExemptEncryption": false
			},
			"usesAppleSignIn": true
		},
		"android": {
			"permissions": ["android.permission.CAMERA"],
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.READ_MEDIA_IMAGES",
				"android.permission.READ_MEDIA_VIDEO",
				"android.permission.READ_MEDIA_AUDIO",
				"android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
			]
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"@clerk/expo",
			[
				"expo-secure-store",
				{
					"faceIDPermission": false
				}
			],
			[
				"expo-localization",
				{
					"supportedLocales": [
						"en",
						"nl"
					]
				}
			],
			"expo-image",
			"expo-sqlite",
			"expo-web-browser",
			"expo-apple-authentication",
			"expo-sharing",
			"expo-camera",
			"expo-image-picker",
			"expo-notifications",
			"expo-asset",
			"expo-font",
			"expo-splash-screen",
			"./plugins/disable-shake-to-edit",
			[
				"@sentry/react-native/expo",
				{
					"project": "foundry",
					"organization": "appelent"
				}
			]
		],
		"locales": {
			"en": "./locales/en.json",
			"nl": "./locales/nl.json"
		},
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9cd74697-33c2-4706-a53e-89627a3b1994"
			}
		},
		"owner": "appelent"
	}
}

# Copy this file to .env.local before starting the Expo app (`pnpm --filter
# @workouts/mobile start`). Every EXPO_PUBLIC_* value is embedded in the app
# bundle, so only ever put a development/test-instance key here, never a
# production key or a production account's credentials.

# Clerk development or test-instance publishable key (pk_test_...). Get it
# from the Clerk dashboard for this project's dev instance -- the same
# instance the web app's VITE_CLERK_PUBLISHABLE_KEY points at.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: enables a one-tap dev sign-in shortcut, mirroring the web app's
# "Dev: log in as test user" button (see CLAUDE.md). Only takes effect when
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY above is a pk_test_ key. Leave unset for
# a normal manual sign-in.
EXPO_PUBLIC_TEST_USER_EMAIL=
EXPO_PUBLIC_TEST_USER_PASSWORD=

# The same Convex dev deployment URL the web app uses (VITE_CONVEX_URL in
# the root .env.local) -- one backend, one Clerk tenant, two clients.
EXPO_PUBLIC_CONVEX_URL=

# Optional: override Foundry's public DSN for a separate Sentry test project.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time source-map uploads. Keep the auth token in .env.local / EAS secrets,
# never in EXPO_PUBLIC_* variables or app.json.
SENTRY_AUTH_TOKEN=
# For local native builds without upload credentials only:
# SENTRY_DISABLE_AUTO_UPLOAD=true

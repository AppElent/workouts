{
  "name": "foundry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "dev": "vite dev --host",
    "dev:all": "pnpm exec convex dev --once && pnpm dev",
    "dev:watch": "concurrently -n convex,vite -c blue,green \"pnpm exec convex dev\" \"pnpm dev\"",
    "build": "vite build && node scripts/generate-sw.mjs",
    "build:development": "CLOUDFLARE_ENV=dev vite build --mode development && node scripts/generate-sw.mjs",
    "preview": "pnpm build:development && wrangler dev",
    "test": "vitest run",
    "build:packages": "pnpm --filter @foundry/core build",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome check --write",
    "check": "biome check && pnpm check:mobile-structure",
    "check:mobile-structure": "node scripts/check-mobile-structure.mjs",
    "seed:exercises": "pnpm exec convex run seed:seedExercises",
    "seed:wods": "pnpm exec convex run seed:seedWods",
    "seed:test": "pnpm exec convex run seed:seedTestData '{\"userId\":\"user_2tTlbmSTh4kbXmg9v6EN7YW3B4d\"}'",
    "seed:clear": "pnpm exec convex run seed:clearUserData '{\"userId\":\"user_2tTlbmSTh4kbXmg9v6EN7YW3B4d\"}'",
    "seed:reset": "pnpm seed:exercises && pnpm seed:wods && pnpm seed:clear && pnpm seed:test",
    "deploy": "pnpm run deploy:prod",
    "deploy:dev": "pnpm exec convex dev --once && pnpm build:development && wrangler deploy --env dev",
    "deploy:prod": "pnpm exec convex deploy && pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "cli:smoke": "tsx cli/index.ts --help && tsx cli/index.ts config get --json && tsx cli/index.ts auth status",
    "foundry": "tsx cli/index.ts",
    "env:check": "node scripts/env.mjs check",
    "env:plan": "node scripts/env.mjs plan",
    "env:apply": "node scripts/env.mjs apply",
    "env:generate": "node scripts/env.mjs generate",
    "env:exec": "node scripts/env.mjs exec",
    "mobile:update:preview": "node scripts/env.mjs exec preview --only eas -- node apps/mobile/scripts/publish-update.mjs preview",
    "mobile:update:production": "node scripts/env.mjs exec production --only eas -- node apps/mobile/scripts/publish-update.mjs production",
    "sentry:convex": "node scripts/convex-sentry.mjs",
    "prototype:ai-food": "ANTHROPIC_API_KEY=\"$(pnpm -s exec convex env get ANTHROPIC_API_KEY)\" tsx scripts/nutrition-ai.prototype.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.9.0",
    "@clerk/react": "^6.18.4",
    "@foundry/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/cloudflare": "11.10.0",
    "@sentry/node": "11.10.0",
    "@sentry/react": "11.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@edge-runtime/vm": "^5.0.0",
    "@sentry/vite-plugin": "11.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "convex-test": "^0.0.66",
    "eas-cli": "24.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.156.1"
  }
}

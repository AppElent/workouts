# Generated by @appelent/dev env generate — do not edit by hand.
#
# Canonical source keys for Workouts.
# Infisical folders, in override order: /, /workouts
# Routing source of truth: env.manifest.ts

# Clerk publishable key used by the web and mobile clients.
# Infisical: clerk-publishable-key
#   VITE_CLERK_PUBLISHABLE_KEY (vite-build: local, preview, dev, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-build: local, preview, dev, production)
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (expo-local: local)
#   published, required
clerk-publishable-key=

# Clerk issuer domain used by Convex to validate JWTs.
# Infisical: clerk-jwt-issuer-domain
#   CLERK_JWT_ISSUER_DOMAIN (convex-functions: local, preview, dev, production)
#   published, required
clerk-jwt-issuer-domain=

# Public URL of the Convex deployment used by each client.
# Infisical: convex-url
#   VITE_CONVEX_URL (vite-build: local, preview, dev, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-build: local, preview, dev, production)
#   EXPO_PUBLIC_CONVEX_URL (expo-local: local)
#   published, required
convex-url=

# Selected Convex deployment reference for local tooling.
# Infisical: convex-deployment
#   CONVEX_DEPLOYMENT (local-tooling: local)
#   published, required
convex-deployment=

# Optional site URL emitted when the selected Convex deployment has one.
# Infisical: convex-site-url
#   CONVEX_SITE_URL (local-tooling: local)
#   published, optional
convex-site-url=

# Convex deployment key used by preview CI or scoped to a workspace.
# Infisical: convex-deploy-key
#   CONVEX_DEPLOY_KEY (local-tooling: local)
#   CONVEX_DEPLOY_KEY (workflow: preview)
#   secret, required
convex-deploy-key=

# Optional Clerk test-user email published in non-production clients.
# Infisical: test-user-email
#   VITE_TEST_USER_EMAIL (vite-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-build: local, preview, dev)
#   EXPO_PUBLIC_TEST_USER_EMAIL (expo-local: local)
#   published, optional
test-user-email=

# Optional Clerk test-user password published in non-production clients.
# Infisical: test-user-password
#   VITE_TEST_USER_PASSWORD (vite-build: local, dev)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-build: local, preview, dev)
#   EXPO_PUBLIC_TEST_USER_PASSWORD (expo-local: local)
#   published, optional
test-user-password=

# Read-packages token used by CI and EAS to install private packages.
# Infisical: node-auth-token
#   NODE_AUTH_TOKEN (workflow: preview)
#   NODE_AUTH_TOKEN (eas-tooling: local, preview, dev, production)
#   secret, required
node-auth-token=

# Cloudflare token used by preview CI to deploy and remove Workers.
# Infisical: cloudflare-account-token
#   CLOUDFLARE_API_TOKEN (workflow: preview)
#   secret, required
cloudflare-account-token=

# Cloudflare account identifier used by preview CI.
# Infisical: cloudflare-account-id
#   CLOUDFLARE_ACCOUNT_ID (workflow: preview)
#   secret, required
cloudflare-account-id=

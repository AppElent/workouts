{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/cli/**/*",
			"convex/**/*",
			"!convex/_generated",
			"scripts/setup-worktree*",
			"scripts/check-mobile-architecture*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"**/vitest.config.ts",
			"apps/mobile/app/**/*",
			"apps/mobile/*.{ts,tsx,js}",
			"packages/*/tsup.config.ts",
			"packages/*/scripts/**/*",
			"!!.claude/worktrees",
			"!!.worktrees",
			"!**/src/routeTree.gen.ts",
			"!designs",
			"!apps/mobile/expo-env.d.ts",
			"!apps/mobile/ios",
			"!apps/mobile/android",
			"!**/src/styles.css",
			"!packages/core/src/nutrition/shipped-foods.json",
			"!packages/core/src/nutrition/shipped-foods.lock.json",
			"!**/*.md"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noReactNativeRawText": "off",
				"useReactNativePlatformComponents": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["apps/mobile/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noReactNativeRawText": {
							"level": "error",
							"options": { "skip": ["AppText", "ReactNative.Text"] }
						}
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.*",
				"apps/mobile/src/test-support/**",
				"src/lib/i18n/runtime/**"
			],
			"linter": {
				"rules": {
					"correctness": { "noComponentHookFactories": "off" }
				}
			}
		},
		{
			"includes": [
				"apps/mobile/src/**",
				"apps/mobile/app/**",
				"!**/*.test.*",
				"!apps/mobile/src/test-support/**",
				"!apps/mobile/src/convex/query-cache.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"convex/react": {
										"importNames": [
											"useQuery",
											"useQueries",
											"usePaginatedQuery"
										],
										"message": "Import query hooks from src/convex/query-cache (docs/standards/convex-query-caching.md)."
									}
								}
							}
						}
					}
				}
			}
		}
	]
}

{
	"compilerOptions": {
		// tsup's dts step (rollup-plugin-dts) injects its own `baseUrl` for
		// module resolution regardless of whether this file sets one, and
		// TypeScript 6's TS5101 turns that into a hard build error. Same
		// silence root tsconfig.json already needs for the same TS 6 change.
		"ignoreDeprecations": "6.0",
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		// Node globals are here for scripts/ only. Nothing under src/ may use them:
		// that code runs on Hermes, where `process` and `Buffer` do not exist.
		"types": ["node"],
		// Off so `import artifact from "./shipped-foods.json"` picks up the hand-
		// written ambient declaration instead of TypeScript inferring a literal
		// type for all ~2,300 records, which costs seconds and a lot of memory.
		"resolveJsonModule": false,
		"declaration": true,
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true
	},
	// `scripts` is included so the generator is held to the same typecheck as
	// the shipped source. tsup decides what gets emitted; nothing under
	// scripts/ reaches dist.
	"include": ["src", "scripts"]
}

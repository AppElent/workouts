{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundry",
  "compatibility_date": "2026-05-04",
  "observability": {
    "enabled": true
  },
  "main": "src/server.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Runtime vars only. The Clerk key and Convex URL are build-time VITE_*
  // values from env.manifest.ts (`pnpm env:apply`); the Worker never reads them.
  "vars": {
    "environment_name": "production"
  },
  "env": {
    // Deploys to foundry-dev.<subdomain>.workers.dev with `pnpm deploy:dev`,
    // which builds with CLOUDFLARE_ENV=dev and values from `env.mjs exec dev`.
    "dev": {
      "name": "foundry-dev",
      "workers_dev": true,
      "vars": {
        "environment_name": "development"
      }
    },
    // What a merge to main deploys (.github/workflows/deploy.yml), built with
    // CLOUDFLARE_ENV=staging. A custom domain, because the production Clerk
    // instance it signs in through accepts only appelent.nl hosts.
    "staging": {
      "name": "foundry-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "foundry-stg.appelent.nl", "custom_domain": true }],
      "vars": {
        "environment_name": "staging"
      }
    },
    // PR previews (preview.yml builds with CLOUDFLARE_ENV=pr and deploys as
    // foundry-pr-<n>). No routes, so a preview never claims the custom domain.
    "pr": {
      "name": "foundry-pr",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "environment_name": "preview"
      }
    }
  }
}

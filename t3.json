{
	"$schema": "https://t3.codes/schema/t3.json",
	"defaultThreadEnvMode": "worktree",
	"scripts": [
		{
			"name": "Prepare worktree",
			"command": "node scripts/workspace.mjs prepare --editor t3",
			"icon": "configure",
			"runOnWorktreeCreate": true,
			"async": false
		},
		{
			"name": "Start Expo mobile",
			"command": "pnpm --filter @foundry/mobile start:dev-client",
			"icon": "play"
		},
		{
			"name": "Start Expo iOS",
			"command": "pnpm --filter @foundry/mobile ios --dev-client",
			"icon": "play"
		},
		{
			"name": "Start Expo Android",
			"command": "pnpm --filter @foundry/mobile android --dev-client",
			"icon": "play"
		}
	]
}
